RAILRADAR_BASE_URL=https://api.railradar.in/v1
RAILRADAR_API_KEY=
# Optional. Set only if you have the correct provider URL template.
# It must contain {station} and {platform}; the backend will append no extra path.
PLATFORM_API_URL_TEMPLATE=
DATABASE_PATH=railway_history.db
MODEL_PATH=railway_delay_model.pkl
MODEL_METADATA_PATH=model_metadata.json
DEFAULT_STATIONS=NDLS:4,ANVT:1
COLLECTION_INTERVAL_SECONDS=7200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
